{
  "name": "coursekit",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "turbo": "^2.11.10",
    "@biomejs/biome": "2.3.2"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "overrides": {
    "multer@^2": "2.5.0",
    "path-to-regexp@^8": "8.4.2",
    "minimatch@^3": "3.1.4",
    "minimatch@^5": "5.1.8",
    "ajv@^6": "6.14.0",
    "ajv@^8": "8.18.0",
    "postcss@^8": "8.5.32",
    "nanoid@^3": "3.3.18",
    "yaml@^2": "2.9.1"
  }
}
